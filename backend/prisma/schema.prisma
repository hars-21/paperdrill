generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  LIMIT
  MARKET
}

enum Side {
  BUY
  SELL
}

enum Status {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELLED
}

enum Scope {
  ACCOUNT_READ  @map("account:read")
  ORDER_READ    @map("order:read")
  ORDER_CREATE  @map("order:create")
  ORDER_CANCEL  @map("order:cancel")
}

enum UserType {
  USER
  SERVICE
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  password      String
  type          UserType  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apikeys       ApiKey[]
  orders        Order[]
  buyFills      Fill[]    @relation("FillBuyer")
  sellFills     Fill[]    @relation("FillSeller")
}

model ApiKey {
  id            String    @id @default(uuid())
  userId        String
  label         String
  hashedSecret  String
  scopes        Scope[]
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id            String   @id
  userId        String 
  symbol        String
  price         BigInt?
  qty           BigInt
  type          OrderType 
  side          Side
  filledQty     BigInt
  status        Status
  lockedAmount  BigInt?
  spentAmount   BigInt
  averagePrice  BigInt?
  createdAt     DateTime

  user          User     @relation(fields: [userId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])
}

model Fill {
  id            String   @id
  symbol        String
  price         BigInt
  qty           BigInt
  isBuyerMaker  Boolean
  buyOrderId    String
  sellOrderId   String
  buyerId       String
  sellerId      String
  createdAt     DateTime

  buyer         User     @relation("FillBuyer", fields: [buyerId], references: [id])
  seller        User     @relation("FillSeller", fields: [sellerId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])
}

model Market {
  id                String  @id @default(uuid())
  name              String
  symbol            String  @unique
  baseAsset         String
  quoteAsset        String
  pricePrecision    Int
  qtyPrecision      Int

  orders Order[]
  fills  Fill[]
}

model Candle {
  symbol    String
  open      BigInt
  high      BigInt
  low       BigInt
  close     BigInt
	volume    BigInt
	time      DateTime @db.Timestamptz()

	@@id([symbol, time])
	@@index([time])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}