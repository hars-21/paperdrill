generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  LIMIT
  MARKET
}

enum Side {
  BUY
  SELL
}

enum Status {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELLED
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  name      String
  password  String

  orders    Order[]
  buyFills  Fill[]  @relation("FillBuyer")
  sellFills Fill[]  @relation("FillSeller")
}

model Order {
  id            String   @id
  userId        String 
  symbol        String
  price         BigInt?
  qty           BigInt
  type          OrderType 
  side          Side
  filledQty     BigInt
  status        Status
  lockedAmount  BigInt?
  spentAmount   BigInt
  averagePrice  BigInt?
  createdAt     DateTime

  user          User     @relation(fields: [userId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])
}

model Fill {
  id            String   @id
  symbol        String
  price         BigInt
  qty           BigInt
  isBuyerMaker  Boolean
  buyOrderId    String
  sellOrderId   String
  buyerId       String
  sellerId      String
  createdAt     DateTime

  buyer         User     @relation("FillBuyer", fields: [buyerId], references: [id])
  seller        User     @relation("FillSeller", fields: [sellerId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])
}

model Market {
  id                String  @id @default(uuid())
  name              String
  symbol            String  @unique
  baseAsset         String
  quoteAsset        String
  pricePrecision    Int
  qtyPrecision      Int

  orders Order[]
  fills  Fill[]
}

model Candle {
  symbol    String
  open      BigInt
  high      BigInt
  low       BigInt
  close     BigInt
	volume    BigInt
	time      DateTime @db.Timestamptz()

	@@id([symbol, time])
	@@index([time])
}