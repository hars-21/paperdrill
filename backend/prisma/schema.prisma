generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  LIMIT
  MARKET
}

enum Side {
  BUY
  SELL
}

enum Status {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELLED
}

enum Scope {
  ACCOUNT_READ  @map("account:read")
  ORDER_READ    @map("order:read")
  ORDER_CREATE  @map("order:create")
  ORDER_CANCEL  @map("order:cancel")
}

enum UserType {
  USER
  SERVICE
}

enum DailyCreditStatus {
  PENDING
  APPLIED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String
  password      String
  type          UserType  @default(USER)
  pnlBaseline   BigInt?
  pnlBaselineAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  apikeys       ApiKey[]
  orders        Order[]
  buyFills      Fill[]    @relation("FillBuyer")
  sellFills     Fill[]    @relation("FillSeller")
  dailyCredits  DailyCredit[]
  balances      Balance[]
  balanceHistory BalanceHistory[]
  positions     Position[]
  positionEvents PositionEvent[]
  portfolioSnapshots PortfolioSnapshot[]
}

model DailyCredit {
  id         String            @id @default(uuid())
  userId     String
  creditDate DateTime          @db.Date
  asset      String
  amount     BigInt
  status     DailyCreditStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  appliedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, creditDate])
  @@index([status, createdAt])
}

model ApiKey {
  id            String    @id @default(uuid())
  userId        String
  label         String
  hashedSecret  String
  scopes        Scope[]
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Order {
  id            String   @id
  userId        String 
  symbol        String
  price         BigInt?
  qty           BigInt
  type          OrderType 
  side          Side
  filledQty     BigInt
  status        Status
  lockedAmount  BigInt?
  spentAmount   BigInt
  averagePrice  BigInt?
  createdAt     DateTime

  user          User     @relation(fields: [userId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])
}

model Fill {
  id            String   @id
  symbol        String
  price         BigInt
  qty           BigInt
  isBuyerMaker  Boolean
  buyOrderId    String
  sellOrderId   String
  buyerId       String
  sellerId      String
  createdAt     DateTime

  buyer         User     @relation("FillBuyer", fields: [buyerId], references: [id])
  seller        User     @relation("FillSeller", fields: [sellerId], references: [id])
  market        Market   @relation(fields: [symbol], references: [symbol])

  @@index([buyerId])
  @@index([sellerId])
}

model Balance {
  userId        String
  asset         String
  available     BigInt
  locked        BigInt
  updatedAt     DateTime

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, asset])
  @@index([asset])
}

model BalanceHistory {
  id             String   @id
  userId         String
  asset          String
  available      BigInt
  locked         BigInt
  deltaAvailable BigInt
  deltaLocked    BigInt
  reason         String
  referenceId    String?
  symbol         String?
  occurredAt     DateTime

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, asset, occurredAt])
  @@index([userId, occurredAt])
  @@index([referenceId])
}

model Market {
  id                String  @id @default(uuid())
  name              String
  symbol            String  @unique
  baseAsset         String
  quoteAsset        String
  pricePrecision    Int
  qtyPrecision      Int

  orders Order[]
  fills  Fill[]
}

model Position {
  userId        String
  asset         String
  qty           BigInt
  costBasis     BigInt
  realizedPnl   BigInt   @default(0)
  lastBuyPrice  BigInt?
  lastBuyQty    BigInt?
  lastBuyAt     DateTime?
  lastSellPrice BigInt?
  lastSellQty   BigInt?
  lastSellAt    DateTime?
  tradeCount    Int      @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, asset])
  @@index([asset])
}

model PositionEvent {
  id              String   @id @default(uuid())
  fillId          String
  userId          String
  asset           String
  symbol          String
  side            String
  price           BigInt
  qty             BigInt
  quoteAmount     BigInt
  costBasisBefore BigInt
  costBasisAfter  BigInt
  realizedPnl     BigInt
  occurredAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fillId, userId])
  @@index([userId, asset, occurredAt])
  @@index([userId, occurredAt])
}

model PortfolioSnapshot {
  id               String   @id @default(uuid())
  userId           String
  at               DateTime
  quoteAsset       String
  cash             BigInt
  positionsValue   BigInt
  equity           BigInt
  realizedPnl      BigInt
  unrealizedPnl    BigInt
  netContributions BigInt
  partial          Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
}

model ProjectionCursor {
  name        String   @id
  lastEventId String
  updatedAt   DateTime @updatedAt
}

model Candle {
  symbol    String
  open      BigInt
  high      BigInt
  low       BigInt
  close     BigInt
	volume    BigInt
	time      DateTime @db.Timestamptz()

	@@id([symbol, time])
	@@index([time])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
