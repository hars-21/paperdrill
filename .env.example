NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/exchange"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-jwt-secret"

# Engine
INCOMING_STREAM="backend-to-engine-broker"
BACKEND_QUEUE_ID=1
ENGINE_TIMEOUT_MS=30000

LOG_LEVEL=debug

SNAPSHOT_INTERVAL=60000

# Bot credentials
BASE_URL=http://localhost:8000
BOT_EMAIL=bot@email.com
BOT_PASSWORD=password
MARKET=SOL_USD