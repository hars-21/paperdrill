NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/paperdrill"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:8000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SERVICE_TOKEN_HASH=""

# Engine
INCOMING_STREAM="backend-to-engine-broker"
BACKEND_QUEUE_ID=1
ENGINE_TIMEOUT_MS=30000

# Engine stream batching
STREAM_RETENTION_MS=600000
SNAPSHOT_INTERVAL=60000
STREAM_READ_BATCH_SIZE=200
RESPONSE_BATCH_SIZE=50

# Engine event log (ordered domain events for downstream projections)
EVENT_STREAM="stream:engine-events"
EVENT_STREAM_RETENTION_MS=3600000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_ORDER_WINDOW_MS=60000

LOG_LEVEL=debug

# Production-only external services. They may be omitted in development and test.
# RESEND_API_KEY=re_...
# EMAIL_FROM=PaperDrill <no-reply@example.com>
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production

# Bot credentials
BASE_URL=http://localhost:8000
SERVICE_TOKEN=your-service-token-here
SERVICE_EMAIL=your-service-email-here
MARKET=SOL_USD
MAX_ORDER_QTY=10
