NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/paperdrill"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="your-jwt-secret"

# Engine
INCOMING_STREAM="backend-to-engine-broker"
BACKEND_QUEUE_ID=1
ENGINE_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_ORDER_WINDOW_MS=60000

LOG_LEVEL=debug

SNAPSHOT_INTERVAL=60000

# Bot credentials
BASE_URL=http://localhost:8000
BOT_EMAIL=bot@gmail.com
BOT_PASSWORD=password
MARKET=SOL_USD