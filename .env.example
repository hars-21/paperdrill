NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/paperdrill"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:8000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
SERVICE_TOKEN_HASH=""

# Engine
INCOMING_STREAM="backend-to-engine-broker"
BACKEND_QUEUE_ID=1
ENGINE_TIMEOUT_MS=30000

# Engine stream batching
STREAM_RETENTION_MS=600000
STREAM_MAXLEN=50000
STREAM_TRIM_INTERVAL_MS=60000
SNAPSHOT_INTERVAL=60000
STREAM_READ_BATCH_SIZE=200
RESPONSE_BATCH_SIZE=50
RESPONSE_QUEUE_TTL_MS=60000

# Engine event log (ordered domain events for downstream projections)
EVENT_STREAM="stream:engine-events"
EVENT_STREAM_RETENTION_MS=3600000
EVENT_STREAM_MAXLEN=500000
EVENT_STREAM_TRIM_INTERVAL_MS=60000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_MAX=600
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_ORDER_WINDOW_MS=60000

LOG_LEVEL=debug

# Production-only external services. They may be omitted in development and test.
# RESEND_API_KEY=re_...
# EMAIL_FROM=PaperDrill <no-reply@example.com>
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production

# Bot credentials
BASE_URL=http://localhost:8000
SERVICE_TOKEN=your-service-token-here
SERVICE_EMAIL=your-service-email-here
MARKET=SOL_USD
MAX_ORDER_QTY=10

# Internal market maker (single service for all markets)
# Symbols map to seeded SERVICE accounts; user ids are resolved from the database.
MARKETS='[{"symbol":"BTC_USD","serviceEmail":"btc.service@paperdrill.dev"},{"symbol":"SOL_USD","serviceEmail":"sol.service@paperdrill.dev"},{"symbol":"ETH_USD","serviceEmail":"eth.service@paperdrill.dev"}]'
QUOTE_INTERVAL_MS=2000
LEVELS_PER_SIDE=8
SPREAD_BPS=20
LEVEL_STEP_BPS=6
DRIFT_BPS=8
MAX_SKEW_BPS=30
MAX_ORDER_NOTIONAL=25
MAX_INVENTORY_NOTIONAL=250
MAX_TOP_UP_NOTIONAL=500
EVENT_CURSOR_KEY=market-maker:event:last_id
